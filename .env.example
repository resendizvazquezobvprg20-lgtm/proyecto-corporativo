APP_NAME="Sistema Corporativo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU-PROYECTO.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Base de datos Railway MySQL ───────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=hopper.proxy.rlwy.net
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────
# Generar con: php artisan jwt:secret --show
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# ── reCAPTCHA v2 (https://www.google.com/recaptcha/admin) ────────────
NOCAPTCHA_SITEKEY=
NOCAPTCHA_SECRET=

# ── Sesión / Cache ────────────────────────────────────────────────────
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
